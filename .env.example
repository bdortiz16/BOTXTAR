# ---------------------------------------------------------------------------
# BOTXTAR - configuracion
# Copia este archivo a .env y completa los valores.
# ---------------------------------------------------------------------------

PORT=3000
NODE_ENV=production

# --- Base de datos --------------------------------------------------------
# En Vercel (o cualquier entorno serverless) hace falta Postgres: el disco del
# contenedor se borra en cada despliegue y un archivo SQLite se perderia con
# todas las operaciones.
#   - Vercel Postgres pone POSTGRES_URL automaticamente al conectar la base.
#   - Neon, Supabase y otros usan DATABASE_URL.
# Si ninguna esta definida, la app usa SQLite en disco (util en local).
# POSTGRES_URL=
# DATABASE_URL=
DB_FILE=./data/botxtar.db

# --- Telegram -------------------------------------------------------------
# Un unico bot para todos los paises: el grupo de cada uno se configura desde
# la pantalla de Ajustes.
TELEGRAM_BOT_TOKEN=

# Grupo al que van las operaciones de paises que todavia no tienen el suyo.
TELEGRAM_FALLBACK_CHAT_ID=

# --- Acceso ---------------------------------------------------------------
# Operadores que pueden entrar. Formato usuario:clave separados por coma.
APP_USERS=bryan:cambia-esta-clave

# Alternativa de un solo usuario (se ignora si APP_USERS esta definido):
# ADMIN_USER=admin
# ADMIN_PASSWORD=

# Firma de las cookies de sesion. OBLIGATORIO en produccion: sin el, cada
# instancia firma distinto y las sesiones se cierran solas. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
SESSION_HOURS=12

# --- Otros ----------------------------------------------------------------
# Zona horaria para la fecha por defecto y los informes.
TIMEZONE=America/Bogota
