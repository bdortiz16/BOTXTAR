# ---------------------------------------------------------------------------
# BOTXTAR - configuracion
# Copia este archivo a .env y completa los valores.
# ---------------------------------------------------------------------------

PORT=3000
NODE_ENV=production

# Bot de Telegram (el que creaste con BotFather).
# Solo se necesita UN bot: cada pais apunta a su propio grupo desde Ajustes.
TELEGRAM_BOT_TOKEN=

# Grupo al que van las operaciones de paises que todavia no tienen grupo propio.
TELEGRAM_FALLBACK_CHAT_ID=

# Operadores que pueden entrar. Formato usuario:clave separados por coma.
APP_USERS=bryan:cambia-esta-clave

# Alternativa de un solo usuario (se ignora si APP_USERS esta definido):
# ADMIN_USER=admin
# ADMIN_PASSWORD=

# Firma de las cookies de sesion. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
SESSION_HOURS=12

# Zona horaria para la fecha por defecto y los informes.
TIMEZONE=America/Bogota

# Ruta del archivo SQLite (montalo en un disco persistente al desplegar).
DB_FILE=./data/botxtar.db
