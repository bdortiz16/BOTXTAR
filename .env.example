# ---------------------------------------------------------------------------
# BOTXTAR - configuracion
# Copia este archivo a .env y completa los valores.
# ---------------------------------------------------------------------------

PORT=3000
NODE_ENV=production

# --- Base de datos --------------------------------------------------------
# En Vercel (o cualquier entorno serverless) hace falta Postgres: el disco del
# contenedor se borra en cada despliegue y un archivo SQLite se perderia con
# todas las operaciones.
#   - Vercel Postgres pone POSTGRES_URL automaticamente al conectar la base.
#   - Neon, Supabase y otros usan DATABASE_URL.
# Si ninguna esta definida, la app usa SQLite en disco (util en local).
# POSTGRES_URL=
# DATABASE_URL=
DB_FILE=./data/botxtar.db

# --- Telegram -------------------------------------------------------------
# Un unico bot para todos los paises: el grupo de cada uno se configura desde
# la pantalla de Ajustes.
TELEGRAM_BOT_TOKEN=

# Grupo al que van las operaciones de paises que todavia no tienen el suyo.
TELEGRAM_FALLBACK_CHAT_ID=

# --- Acceso ---------------------------------------------------------------
# Las cuentas se crean desde la pagina publica y se guardan en la base con la
# clave cifrada. La primera cuenta se puede crear sin nada; a partir de ahi
# hace falta este codigo de invitacion. Ponlo apenas crees tu cuenta: sin el,
# el registro queda cerrado y nadie mas puede entrar.
SIGNUP_CODE=

# Cuentas de respaldo definidas por variable, por si alguien se queda fuera.
# Formato usuario:clave separados por coma. Opcional.
# APP_USERS=bryan:cambia-esta-clave

# Alternativa de un solo usuario de respaldo:
# ADMIN_USER=admin
# ADMIN_PASSWORD=

# Modo sin clave para trastear en local. NO funciona en produccion.
# ALLOW_ANONYMOUS=1

# Firma de las cookies de sesion. OPCIONAL: si no se define, la app genera una
# y la guarda en la base, de modo que todas las instancias firmen igual.
# Definirla a mano sirve para que las sesiones sobrevivan a cambiar de base.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=
SESSION_HOURS=12

# --- Otros ----------------------------------------------------------------
# Zona horaria para la fecha por defecto y los informes.
TIMEZONE=America/Bogota
